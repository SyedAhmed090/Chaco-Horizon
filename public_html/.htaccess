# Chaco Horizon — cPanel / Apache
# Copied verbatim into dist/ by Vite. Works from public_html or a sub-folder.

Options -Indexes
DirectoryIndex index.html

# --- HTTPS + canonical host --------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # force https — but not when a CDN / proxy already terminated TLS in front of
  # Apache (then %{HTTPS} is never "on" and the rule would loop forever)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP:X-Forwarded-SSL} !=on
  RewriteCond %{HTTP:CF-Visitor} !"scheme":"https"
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Force www, for ANY domain this is deployed on, so the canonical host in
  # site.config.js (https://www.chacohorizon.com) is the one that answers.
  # Skips hosts that are already www, and skips bare hostnames with no dot
  # (localhost) and sub.domain.tld style test hosts, which must not gain a www.
  # To serve a BARE domain instead, delete these three lines and drop the
  # "www." from `url` in site.config.js before building.
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^[^.]+\.[^.]+$
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

# --- caching -----------------------------------------------------------------
# assets/* are content-hashed by Vite: cache forever. Everything else revalidates.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

# --- keep helper files private -----------------------------------------------
<FilesMatch "^(README\.txt|\.htaccess|mail\.config.*\.php)$">
  Require all denied
</FilesMatch>
# PHPMailer sources, if installed, are include-only
<IfModule mod_rewrite.c>
  RewriteRule ^php/ - [F,L]
</IfModule>

# --- clean 404 ---------------------------------------------------------------
ErrorDocument 404 /404.html
